# Copy this file to .env and replace every value.
# Create/rotate token: https://dashboard.ngrok.com/authtokens
NGROK_AUTHTOKEN=replace-with-your-private-ngrok-authtoken

# Your one assigned ngrok dev domain, without https:// or a trailing slash.
# Find it at: https://dashboard.ngrok.com/domains
NGROK_DOMAIN=your-assigned-domain.ngrok-free.dev
